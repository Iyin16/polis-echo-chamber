# POLIS Production Environment Configuration Template
# Copy this file to .env.local and fill in your values
# WARNING: Never commit .env files with real secrets to version control

# ========== ALCHEMY & BLOCKCHAIN ==========
# Alchemy API key for Arbitrum Sepolia
# Get key at: https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Alternative/custom Arbitrum Sepolia RPC URL (optional)
# If not set, will use Alchemy endpoint with above key
ARBITRUM_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your_key_here

# PolisAgentNFT contract address on Arbitrum Sepolia
VITE_POLIS_NFT_CONTRACT=0x...your_contract_address_here

# Legacy Hardhat & Contract Deployment (kept for compatibility)
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# ========== AWS S3 CONFIGURATION ==========
# AWS S3 bucket for portrait storage
AWS_S3_BUCKET=polis-agent-portraits

# AWS region for S3
AWS_S3_REGION=us-east-1

# AWS IAM credentials (use least-privilege IAM user with S3 access only)
# Consider using AWS SigV4 or temporary credentials instead of long-term keys
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ========== LEGACY FRONTEND CONFIG (kept for compatibility) ==========
REACT_APP_POLIS_NFT_CHAIN_ID=421614
REACT_APP_DEPLOYER_ADDRESS=0x...
REACT_APP_ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# 0G Storage (if using)
NEXT_PUBLIC_0G_STORAGE_ENDPOINT=your_endpoint_here

# ========== DEVELOPMENT SETTINGS ==========
# Set to 'development' for enhanced debugging, 'production' for optimized builds
NODE_ENV=development

# Vite will use this to determine if it's a client/server build
VITE_MODE=development

# ========== LOGGING & MONITORING ==========
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=https://your_sentry_url

# ========== API ENDPOINTS ==========
# Backend API endpoint (if using server-side functions)
# VITE_API_URL=http://localhost:5173/api

# ========== DEPLOYMENT ==========
# Deployment environment
DEPLOYMENT_ENV=staging

# Deployment URL
VITE_DEPLOYMENT_URL=https://polis.example.com
